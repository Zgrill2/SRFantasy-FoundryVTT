{
  "name": "shimmeringreach",
  "version": "2.0.0",
  "description": "The Shimmering Reach system for FoundryVTT",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:watch": "tsc -p tsconfig.json --noEmit --watch --preserveWatchOutput",
    "dev": "concurrently -k -n vite,tsc -c cyan,magenta \"npm:watch\" \"npm:typecheck:watch\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "fvtt-types": "github:League-of-Foundry-Developers/foundry-vtt-types#5903a84fe5b0618f41877b387dc4bb45b1327db8",
    "rimraf": "^6.0.1",
    "sass": "^1.101.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vite-plugin-static-copy": "^2.2.0",
    "vitest": "^2.1.8"
  }
}
