    "description": "The Shimmering Reach system for FoundryVTT — a d6 dicepool fantasy RPG.",
    "version": "2.0.0",
    "compatibility": {
        "minimum": "14",
        "verified": "14"
    },
    "authors": [{ "name": "Ernest Wunder" }, { "name": "Dimitri Dolgov" }],
    "esmodules": ["shimmeringreach.js"],
    "styles": ["shimmeringreach.css"],
    "languages": [
        {
            "lang": "en",
            "name": "English",
            "path": "lang/en.json"
        }
    ],
